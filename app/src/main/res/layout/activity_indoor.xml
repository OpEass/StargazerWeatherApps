<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    tools:context=".IndoorActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- ================= HEADER ================= -->
        <TextView
            android:id="@+id/tvTitleIndoor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Aktivitas Indoor"
            android:textColor="#1A1A1A"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitleIndoor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitleIndoor"
            app:tint="#1A1A1A" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pilih atau hapus aktivitas indoor yang tampil di beranda."
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleIndoor" />


        <!-- ================= GRID AKTIVITAS ================= -->
        <LinearLayout
            android:id="@+id/gridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

            <!-- Baris 1: Yoga & Baca Buku -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card 1: Yoga -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardYoga"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvYogaIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧘 Yoga"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvYogaIcon"
                            android:layout_marginTop="4dp"
                            android:text="Aktif di beranda"
                            android:textColor="#4CAF50"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleYoga"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#E53935" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 2: Baca Buku -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBacaBuku"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvBacaBukuIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖 Baca Buku"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvBacaBukuIcon"
                            android:layout_marginTop="4dp"
                            android:text="Aktif di beranda"
                            android:textColor="#4CAF50"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleBacaBuku"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#E53935" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Baris 2: Memasak & Menonton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card 3: Memasak -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMemasak"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMemasakIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👨‍🍳 Memasak"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvMemasakIcon"
                            android:layout_marginTop="4dp"
                            android:text="Aktif di beranda"
                            android:textColor="#4CAF50"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleMemasak"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#E53935" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 4: Menonton -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMenonton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMenontonIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📺 Menonton"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvMenontonIcon"
                            android:layout_marginTop="4dp"
                            android:text="Belum ditambahkan"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleMenonton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#2196F3" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Baris 3: Musik & Melukis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card 5: Musik -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMusik"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMusikIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎸 Musik"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvMusikIcon"
                            android:layout_marginTop="4dp"
                            android:text="Belum ditambahkan"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleMusik"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#2196F3" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 6: Melukis -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMelukis"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMelukisIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 Melukis"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvMelukisIcon"
                            android:layout_marginTop="4dp"
                            android:text="Belum ditambahkan"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnToggleMelukis"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#2196F3" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>